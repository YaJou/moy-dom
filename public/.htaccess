# Security + caching headers
AddDefaultCharset UTF-8

<IfModule mod_mime.c>
  AddCharset UTF-8 .txt .html .css .js .xml .json .md .svg
  AddType "text/plain; charset=utf-8" .txt
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
  Header set X-XSS-Protection "1; mode=block"

  # HSTS: enforce HTTPS for 1 year (include subdomains after confirming www redirects)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # CSP: allow self + Yandex maps/metrika + VK/WhatsApp/Telegram links + Unsplash fallbacks if any
  Header set Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'none'; img-src 'self' data: blob: https:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://mc.yandex.ru https://mc.yandex.com https://api-maps.yandex.ru https://yastatic.net; connect-src 'self' https://mc.yandex.ru https://mc.yandex.com https://api-maps.yandex.ru https://yandex.ru https://*.yandex.ru https://*.yandex.net; frame-src 'self' https://yandex.ru https://*.yandex.ru https://www.youtube.com https://youtube.com; media-src 'self' https:; upgrade-insecure-requests"

  <Files "llms.txt">
    Header set Content-Type "text/plain; charset=utf-8"
  </Files>

  <FilesMatch "\.(js|css|woff2|woff|ttf|otf|eot|ico|svg|gif|jpg|jpeg|png|webp|avif|mp4|webm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(html?)$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/html "access plus 5 minutes"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # www → non-www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Add trailing slash for extensionless URLs (directories / clean paths)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{1,5}$
  RewriteRule ^(.*)$ /$1/ [L,R=301]

  # Pretty catalog filters → working query URLs
  RewriteRule ^catalog/one-story/?$ /catalog/?floors=1%20%D1%8D%D1%82%D0%B0%D0%B6 [L,R=301,NE,QSA]
  RewriteRule ^catalog/two-story/?$ /catalog/?floors=2%20%D1%8D%D1%82%D0%B0%D0%B6%D0%B0 [L,R=301,NE,QSA]
  RewriteRule ^catalog/garage/?$ /catalog/ [L,R=301]
  RewriteRule ^catalog/terrace/?$ /catalog/ [L,R=301]

  # Legacy / dead routes → closest live pages
  RewriteRule ^catalog/1/?$ /catalog/balakovo/ [L,R=301]
  RewriteRule ^projects(/.*)?$ /catalog/ [L,R=301]
  RewriteRule ^plots(/.*)?$ /catalog/ [L,R=301]
  RewriteRule ^reviews(/.*)?$ /#reviews [L,R=301,NE]
  RewriteRule ^works(/.*)?$ /built/ [L,R=301]
</IfModule>
